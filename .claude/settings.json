{
  "worktree": { "bgIsolation": "none" },
  "permissions": {
    "allow": [
      "Bash(./gradlew :shared:testAndroidHostTest*)",
      "Bash(./gradlew :shared:compile*)",
      "Bash(./gradlew :shared:iosSimulatorArm64Test*)",
      "Bash(./gradlew :androidApp:assembleDebug*)",
      "Bash(ktlint *)",
      "Bash(deno check *)",
      "Bash(deno lint *)",
      "Bash(deno test *)",
      "Bash(deno fmt --check *)",
      "Bash(scripts/harness/*)",
      "Bash(supabase db lint*)",
      "Bash(supabase test db*)",
      "Bash(supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase functions deploy*)",
      "Bash(supabase functions delete*)",
      "Bash(supabase secrets *)",
      "Bash(supabase link*)"
    ],
    "deny": [
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
